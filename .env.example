ENVIRONMENT=local
DATABASE_URL=sqlite:///./donations.db

# PayPal: https://developer.paypal.com/dashboard/applications  (sandbox | live)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

DONATION_CURRENCY=USD
DONATION_MIN=1.00
DONATION_MAX=10000.00

# Azure AD (Entra ID) app registration that protects the admin API
AZURE_TENANT_ID=
AZURE_API_AUDIENCE=
AZURE_ADMIN_ROLE=Donations.Admin

# Optional: load PayPal secrets / DATABASE_URL from Key Vault via managed identity
KEY_VAULT_URL=
